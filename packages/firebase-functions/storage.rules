rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }
    
    function isValidFileType() {
      return isImage() || isPDF();
    }
    
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    // User profile pictures
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && isImage() && isValidFileSize();
    }
    
    // Invoice images
    match /invoices/{userId}/{invoiceId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileType() && isValidFileSize();
    }
    
    // Receipt images
    match /receipts/{userId}/{receiptId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileType() && isValidFileSize();
    }
    
    // Expense images
    match /expenses/{userId}/{expenseId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileType() && isValidFileSize();
    }
    
    // Default deny all other requests
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
